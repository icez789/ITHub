# Dedicated ITHub E2E database only. Copy this file to .env.e2e.local and
# provide non-production credentials. Never point these commands at Production.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=ithub_e2e

ITHUB_E2E_ALLOW_WRITES=true
ITHUB_E2E_ENVIRONMENT=e2e
ITHUB_E2E_EMAIL=
ITHUB_E2E_PASSWORD=
ITHUB_E2E_USERNAME=ithub_e2e_member
ITHUB_E2E_BASE_URL=http://127.0.0.1:3000

# Application secrets/integrations required by the local Next.js server.
AUTH_SECRET=
SESSION_SECRET=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
