{
  "name": "ithub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib tests scripts playwright.config.js eslint.config.mjs next.config.mjs",
    "test:e2e": "node --env-file-if-exists=.env.e2e.local scripts/run-e2e.mjs",
    "db:preflight": "node --env-file-if-exists=.env scripts/db-preflight.mjs",
    "db:preflight:e2e": "node --env-file-if-exists=.env.e2e.local scripts/db-preflight.mjs --e2e",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:migrate:e2e": "node --env-file-if-exists=.env.e2e.local scripts/db-migrate.mjs --e2e",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.mjs",
    "db:seed:e2e": "node --env-file-if-exists=.env.e2e.local scripts/db-seed-e2e.mjs --e2e",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs",
    "db:check:e2e": "node --env-file-if-exists=.env.e2e.local scripts/db-check.mjs --e2e",
    "db:reconcile": "node --env-file-if-exists=.env scripts/db-reconcile.mjs",
    "db:reconcile:e2e": "node --env-file-if-exists=.env.e2e.local scripts/db-reconcile.mjs --e2e",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.23.24",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.554.0",
    "mysql2": "^3.15.3",
    "next": "^16.2.11",
    "nextjs-toploader": "^3.9.17",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.6.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.6",
    "sweetalert2": "^11.26.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17"
  },
  "overrides": {
    "quill": "2.0.2"
  }
}
